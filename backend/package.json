{
  "name": "happydiet-backend",
  "version": "0.1.0",
  "description": "HappyDiet backend - tool endpoints for Live API",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "dev:demo": "tsx watch src/dev-server.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:ci": "mkdir -p test-results && CI=1 vitest run --coverage",
    "test:ci:full": "npm ci && npm run test:ci && npm run build",
    "test:uat": "npm run build && node scripts/uat-live.mjs",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google-cloud/vertexai": "^1.6.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "google-auth-library": "^10.6.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
