# HappyDiet Backend - copy to .env (do not commit .env)
# Required: Vertex AI, Firestore, Text-to-Speech
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Vertex AI model (default: gemini-2.5-flash)
# VERTEX_AI_MODEL=gemini-2.5-flash

# Optional: Firestore databases (omit to use default "(default)" for both)
# FIRESTORE_DATABASE_MEALS=happydiet   # meals, data model
# FIRESTORE_DATABASE_RULES=rules      # diet rules parsing

# Text-to-Speech: uses same project; enable texttospeech.googleapis.com

# Optional: Service account JSON for local dev (otherwise uses gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional: API key for X-API-Key header (Live API → backend)
# API_KEY=your-secret-api-key

PORT=8080
